<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zw.sserver.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.zw.sserver.model.entity.ChatMessage">
        <id property="messageId" column="message_id" />
        <result property="clientMsgId" column="client_msg_id" />
        <result property="senderId" column="sender_id" />
        <result property="receiverId" column="receiver_id" />
        <result property="cipherContent" column="cipher_content" />
        <result property="isRead" column="is_read" />
        <result property="sendTime" column="send_time" />
    </resultMap>

    <sql id="Base_Column_List">
        message_id,client_msg_id,sender_id,receiver_id,cipher_content,is_read,send_time
    </sql>
</mapper>
