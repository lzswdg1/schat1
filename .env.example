# Local development example. Fill each secret with a separate random value.
# Copy to .env; never commit the populated file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=schat
MYSQL_USERNAME=schat
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SCHAT_JWT_SECRET=
SCHAT_INTERNAL_SECRET=

# Defaults use loopback and fixed local development ports.
USER_SERVICE_PORT=8081
CHAT_SERVICE_PORT=8082
FILE_SERVICE_PORT=8083
GATEWAY_PORT=8080
SCHAT_INSTANCE_ID=local-chat-1
SCHAT_LOGIN_TRUSTED_PROXIES=

# Optional operations and webhook; use independent secrets when enabling either.
SCHAT_DELIVERY_OPS_ENABLED=false
SCHAT_DELIVERY_OPS_SECRET=
SCHAT_DELIVERY_OPS_AUTO_CLEANUP_ENABLED=false
SCHAT_DELIVERY_ALERT_ENABLED=false
SCHAT_DELIVERY_ALERT_URL=
SCHAT_DELIVERY_ALERT_SECRET=
